    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.8",
    "wrangler": "^4.10.0"
  },
  "dependencies": {
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
