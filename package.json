{
  "name": "weathercock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "轻量、开源的 New API 中转站常用模型状态与资费聚合监控工具（风见鸡 Weathercock）",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "dev:api": "wrangler dev",
